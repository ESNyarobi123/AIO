# Copy to deploy/.env on the server and change every secret.
POSTGRES_USER=aiq
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=aiq_hireflow
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
ACME_EMAIL=admin@aiqltd.co.tz
# Swagger document generation costs ~100 MB of RAM; keep it off on 512 MB droplets.
SWAGGER_ENABLED=false
# Small Postgres connection pool to protect the API on a 512 MB droplet.
DATABASE_POOL_MAX=5
