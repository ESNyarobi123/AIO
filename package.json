{
  "name": "aiq-hireflow",
  "version": "1.0.0",
  "private": true,
  "description": "AIQ HireFlow monorepo — Equipment Rental, Inventory & Operations",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @aiq-hireflow/api start:dev",
    "dev:web": "pnpm --filter @aiq-hireflow/web dev",
    "build:api": "pnpm --filter @aiq-hireflow/api build",
    "db:migrate": "pnpm --filter @aiq-hireflow/api prisma:migrate",
    "db:seed": "pnpm --filter @aiq-hireflow/api db:seed",
    "db:studio": "pnpm --filter @aiq-hireflow/api prisma:studio",
    "lint:api": "pnpm --filter @aiq-hireflow/api lint"
  }
}
